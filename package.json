{
  "name": "@afilimax/mercado-livre-provider",
  "description": "Provedor de links de afiliados para o Mercado Livre, integrado ao ecossistema Afilimax. Este pacote permite converter URLs de produtos do Mercado Livre em links de afiliados encurtados utilizando a API oficial (via headers de autenticação/cookies).",
  "version": "0.1.1",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afilimax/mercado-livre-provider.git"
  },
  "homepage": "https://github.com/Afilimax/mercado-livre-provider#readme",
  "bugs": {
    "url": "https://github.com/Afilimax/mercado-livre-provider/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "afilimax",
    "mercado livre",
    "afiliados",
    "mercado livre afiliado"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "prettier-plugin-sort-imports": "^1.8.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@afilimax/core": "^0.4.1"
  }
}
